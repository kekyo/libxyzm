{
  "version": 4,
  "configurations": [
    {
      "name": "Linux POSIX",
      "compilerPath": "/usr/bin/g++",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c99",
      "cppStandard": "c++20",
      "defines": [
        "XYZM_HAVE_POSIX=1"
      ],
      "compilerArgs": [
        "-pthread"
      ],
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}",
        "${workspaceFolder}/tests",
        "${workspaceFolder}/samples/support",
        "${workspaceFolder}/deps/cardio/include"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/tests",
          "${workspaceFolder}/samples",
          "${workspaceFolder}/../libbounce/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
